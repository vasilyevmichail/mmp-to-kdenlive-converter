{
    "name": "vasilyevmichail/mmp-to-kdenlive-converter",
    "description": "Convert MMP-exported JSON track lists into Kdenlive (.kdenlive) projects",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Vasilyevmichail\\MmpToKdenlive\\": "src/"
        }
    },
    "bin": [
        "bin/mmp-to-kdenlive"
    ],
    "keywords": ["kdenlive", "mlt", "mmp", "video", "converter"],
    "authors": [
        {
            "name": "Vasilyev Mikhail"
        }
    ]
}